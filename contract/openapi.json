{
  "openapi": "3.0.3",
  "info": {
    "title": "CSK Hub API",
    "version": "1.0.0",
    "description": "Authentication endpoints under /api/auth belong to Better Auth and are used through its client."
  },
  "components": {
    "schemas": {
      "CurrentActor": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "impersonatedBy": {
            "type": "string",
            "nullable": true,
            "description": "The impersonating Admin's User ID, or null for the User's own session."
          }
        },
        "required": [
          "userId",
          "isAdmin",
          "impersonatedBy"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "VALIDATION_FAILED",
              "INTERNAL"
            ],
            "description": "Stable error code. Clients must tolerate unknown codes."
          }
        },
        "required": [
          "code"
        ]
      },
      "MemberIdSession": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/MemberIdMember"
          },
          "canVerify": {
            "type": "boolean",
            "description": "A UI hint only; verification re-checks authority."
          }
        },
        "required": [
          "member",
          "canVerify"
        ]
      },
      "MemberIdMember": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "nullable": true,
            "description": "The User's photo URL, or null when none is set."
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "choirs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            "description": "Current Choir affiliations, excluding archived Groups. May be empty."
          }
        },
        "required": [
          "id",
          "name",
          "image",
          "accountStatus",
          "choirs"
        ]
      },
      "MemberIdError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "INVALID_CODE",
              "INVALID_REQUEST",
              "UNAVAILABLE"
            ],
            "description": "Stable error code. Clients must tolerate unknown codes."
          }
        },
        "required": [
          "code"
        ]
      },
      "MemberIdCode": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The opaque QR value. Never put it in a URL, log or storage."
          },
          "issuedAt": {
            "type": "integer",
            "description": "Unix milliseconds."
          },
          "expiresAt": {
            "type": "integer",
            "description": "Unix milliseconds, exclusive; `issuedAt` + 10,000."
          },
          "rotateAfterMs": {
            "type": "integer",
            "description": "Fetch the next code after this many milliseconds."
          }
        },
        "required": [
          "token",
          "issuedAt",
          "expiresAt",
          "rotateAfterMs"
        ]
      },
      "MemberIdVerification": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/MemberIdMember"
          },
          "verifiedAt": {
            "type": "integer",
            "description": "Unix milliseconds. A snapshot, not a lasting grant."
          }
        },
        "required": [
          "member",
          "verifiedAt"
        ]
      },
      "MemberIdVerificationRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "token"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getCurrentActor",
        "summary": "The signed-in, active User behind this request, freshly resolved.",
        "tags": [
          "session"
        ],
        "responses": {
          "200": {
            "description": "The current actor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentActor"
                }
              }
            }
          },
          "401": {
            "description": "No active signed-in User.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/member-id/session": {
      "get": {
        "operationId": "getMemberIdSession",
        "summary": "The signed-in User's own Member ID profile and whether they may verify others.",
        "tags": [
          "member-id"
        ],
        "responses": {
          "200": {
            "description": "The caller's profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdSession"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: no active, signed-in User, including Inactive Users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "403": {
            "description": "`FORBIDDEN`: the User may not hold a Member ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "503": {
            "description": "`UNAVAILABLE`: Member ID is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          }
        }
      }
    },
    "/api/member-id/issue": {
      "post": {
        "operationId": "issueMemberId",
        "summary": "Issues a short-lived Member ID code for the caller's own, non-impersonated session.",
        "description": "Any request body is ignored.",
        "tags": [
          "member-id"
        ],
        "responses": {
          "200": {
            "description": "A fresh code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdCode"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: no active, signed-in User, including Inactive Users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "403": {
            "description": "`FORBIDDEN`: the User may not hold a Member ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "503": {
            "description": "`UNAVAILABLE`: Member ID is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          }
        }
      }
    },
    "/api/member-id/verify": {
      "post": {
        "operationId": "verifyMemberId",
        "summary": "Admin-only visual verification of a member's current code.",
        "description": "Rechecks the subject's stored, unexpired, non-impersonated session and active account. A missing subject is indistinguishable from an invalid code.",
        "tags": [
          "member-id"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberIdVerificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The verified member.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdVerification"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_CODE`: expired, forged or revoked code, or an inactive subject. `INVALID_REQUEST`: malformed JSON or token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`: no active, signed-in User, including Inactive Users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "403": {
            "description": "`FORBIDDEN`: the caller is not an Admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "413": {
            "description": "`INVALID_REQUEST`: the body exceeds 4 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "415": {
            "description": "`INVALID_REQUEST`: the body is not JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          },
          "503": {
            "description": "`UNAVAILABLE`: Member ID is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberIdError"
                }
              }
            }
          }
        }
      }
    }
  }
}

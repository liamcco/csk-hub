{
  "name": "csk-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web; wait",
    "build": "bun run build:web && bun run build:api",
    "tst": "bun test --dots",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write --linter-enabled=false",
    "auth:generate": "auth generate --config src/core/auth/index.ts --output src/core/db/schema/auth.ts -y",
    "db:generate": "drizzle-kit generate",
    "db": "bun scripts/dev/index.ts",
    "api:contract": "bun scripts/api/export-contract.ts",
    "api:generate": "bun run api:contract && bun install --cwd tools/api-client --frozen-lockfile && bun run --cwd tools/api-client generate",
    "e2e": "bun run e2e/run.ts",
    "pr": "bun tst && bun lint && bun typecheck && bun run build",
    "fallow": "bunx fallow",
    "dev:api": "PORT=3001 bun --watch src/api/server.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:api": "bun build src/api/server.ts --target=bun --external=pg-native --outfile=dist/api.js && bun build src/cli/index.ts --target=bun --external=pg-native --outfile=dist/cli.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@better-auth/i18n": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "@wrksz/themes": "^1.2.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.19",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "nodemailer": "^10.0.9",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "redis": "^6.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "4.15.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@biomejs/biome": "2.5.13",
    "@clack/prompts": "^1.8.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "archunit": "^2.5.4",
    "auth": "1.7.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^4.1.11"
  },
  "type": "module"
}

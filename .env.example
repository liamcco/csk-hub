# Environment Configuration
ENVIRONMENT=development

# DATABASE
# Required. With `docker compose -f deploy/compose.dev.yml up -d` this matches that file.
# The deployed stack sets its own (see deploy/stack.env.example).
POSTGRES_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# REALTIME (optional; enables SSE, live badges and best-effort notification fallback)
# Standard Redis 7+, with no vendor SDK. Self-hosted Redis and compatible managed hosts work.
# docker compose -f deploy/compose.dev.yml up -d starts Redis locally. Leave these variables unset to disable realtime.
# REDIS_URL="redis://localhost:6379"
# REDIS_KEY_PREFIX=csk-hub-development
# Delivery runs after app responses; no separate worker is required.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Set the explicit application origin in production; localhost is for development.
BETTER_AUTH_URL="http://localhost:3000"
# Where the web server calls the API. Unset in `next dev`, which serves the API itself; the
# Compose stack sets it to http://api:3000.
# API_INTERNAL_URL="http://api:3000"
# Preview deployments use Vercel's injected VERCEL_URL and optional VERCEL_BRANCH_URL.
# Enable access to System Environment Variables in the Vercel project settings.

# EMAIL
# With no SMTP credentials, messages are logged so local flows remain usable.
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# VAPID KEYS (generated at https://vapidkeys.com)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The web app's copy of the public key (Vite exposes only VITE_ variables to the browser).
VITE_VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
CONTACT_EMAIL=

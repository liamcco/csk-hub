# The stack's single origin. Routing is by path only:
#   /api/realtime/*  the web server, until real-time delivery moves to the API
#   /api, /api/*     the standalone API, which answers unknown API paths itself (404 NOT_FOUND)
#   everything else  the web server
# Nothing is compressed or buffered, so server-sent events stream as they are written.
{
	admin off
	# Locally Caddy issues its own certificate for localhost; installing its root into the
	# container's trust store is pointless, so it is skipped.
	skip_install_trust
}

{$SITE_ADDRESS} {
	handle /api/realtime/* {
		reverse_proxy web:3000 {
			flush_interval -1
			# Longer than the event stream's keep-alive, so idle streams are not cut.
			transport http {
				read_timeout 0
			}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

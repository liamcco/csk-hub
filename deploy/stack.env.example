# Configuration for deploy/compose.yml. Copy to stack.env (never committed) or enter the same
# variables in Portainer's stack editor. For a local stack, deploy/local-stack.sh writes its own.

# The release images, pinned by digest as deploy/publish-image.sh prints them. Deploy the pair
# published from one commit.
CSK_HUB_API_IMAGE=ghcr.io/herr-ek/csk-hub-api@sha256:<digest>
CSK_HUB_WEB_IMAGE=ghcr.io/herr-ek/csk-hub-web@sha256:<digest>

# Host port the stack's web server listens on; GUD's reverse proxy forwards the public origin here.
APP_PORT=8443
# What the proxy serves: plain http behind a TLS-terminating proxy. Locally: https://localhost:8443.
SITE_ADDRESS=http://:8443

# Generate each with: openssl rand -hex 32
# The schema owner, used only by the migrate job.
POSTGRES_PASSWORD=
# The data-only role (csk_hub_app) the API and web server connect as; migrate sets it.
POSTGRES_APP_PASSWORD=

# The public origin people use, e.g. https://hub.example.org
BETTER_AUTH_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email: smtp in a real deployment; log prints messages to the containers' output instead.
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push. Generate with: bunx web-push generate-vapid-keys
# The public key is also built into the image (see README.md), so both must match.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CONTACT_EMAIL=webmaster@choir.chs.chalmers.se
